.DS_Store
*/tmux/plugins/
Brewfile.lock.json

# Pi runtime state — excluded from Dotfile-managed tool config
.pi/agent/bin/
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/sessions/
.pi/agent/ctx/
.pi/agent/git/
.pi/agent/npm/
.pi/node_modules/
.pi/package.json
.pi/pnpm-lock.yaml
.pi/.DS_Store
.pi/agent/.DS_Store
.pi/agent/crashes.json

# OpenCode local runtime state and installed dependencies are never tracked.
.config/opencode/auth.json
.config/opencode/antigravity-accounts.json
.config/opencode/ctx/
.config/opencode/*.db
.config/opencode/*.log
.config/opencode/service.json
.config/opencode/node_modules/
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/pnpm-lock.yaml
.config/opencode/yarn.lock
.config/opencode/bun.lock
.config/opencode/bun.lockb
.config/opencode/.DS_Store
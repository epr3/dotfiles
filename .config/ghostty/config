# Ghostty config — Zellij launch.

# Font
font-family = "Inconsolata Nerd Font"
font-size = 16

# Theme
theme = Catppuccin Macchiato

# Window appearance
window-decoration = auto
macos-titlebar-style = transparent

# Keyboard
macos-option-as-alt = left
# Ghostty otherwise turns these into Alt+b / Alt+f for shell word navigation;
# Alt+f toggles Zellij floating panes. Send the legacy Alt-arrow sequences
# Zellij is configured to consume instead.
keybind = alt+arrow_left=csi:1;3D
keybind = alt+arrow_right=csi:1;3C

window-padding-balance = true

# Initialize the shell PATH before launching Zellij so layout/resurrect
# commands (lazygit, pi, etc.) can resolve outside an interactive pane.
command = /opt/homebrew/bin/zellij

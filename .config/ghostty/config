# Ghostty config — Zellij launch.

# Font
font-family = "Inconsolata Nerd Font"
font-size = 18

# Theme
theme = Catppuccin Macchiato

# Window appearance
window-decoration = auto
macos-titlebar-style = transparent

# Keyboard
macos-option-as-alt = left

# Initialize the shell PATH before launching Zellij so layout/resurrect
# commands (lazygit, pi, etc.) can resolve outside an interactive pane.
command = /opt/homebrew/bin/zsh -lic 'exec /opt/homebrew/bin/zellij'

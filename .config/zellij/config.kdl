// Zellij configuration — Dotfile-managed tool config.


// Catppuccin Macchiato — built-in, matches Ghostty and Neovim.
// Pin the dark variant so the terminal's colour-scheme negotiation cannot
// replace it with Zellij's default palette.
theme "catppuccin-macchiato"
theme_dark "catppuccin-macchiato"
explicit_theme_hue "dark"

// Use the built-in bindings, including Ctrl-o then w (sessions) / d (detach).
default_shell "/bin/zsh"

// Pi enables the Kitty keyboard protocol, whose enhanced Alt-arrow sequences
// Zellij 0.45.1 does not match for pane navigation. Keep legacy input so
// Zellij's stock Alt+arrow / Alt+hjkl focus bindings remain reliable.
// Requires restarting Zellij sessions.
support_kitty_keyboard_protocol false
